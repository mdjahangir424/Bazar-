{
  "entities": {
    "MarketExpense": {
      "title": "MarketExpense",
      "description": "Daily market grocery expense record for a user",
      "type": "object",
      "properties": {
        "serialNo": {
          "type": "integer",
          "description": "Sequential entry number"
        },
        "date": {
          "type": "string",
          "description": "Date in YYYY-MM-DD format"
        },
        "amount": {
          "type": "number",
          "description": "Expense amount in BDT"
        },
        "note": {
          "type": "string",
          "description": "Optional expense note"
        },
        "createdAt": {
          "type": "integer",
          "description": "Creation timestamp in milliseconds"
        },
        "ownerUid": {
          "type": "string",
          "description": "User ID of the owner"
        }
      },
      "required": ["date", "amount"]
    },
    "OutstandingEntry": {
      "title": "OutstandingEntry",
      "description": "Daily outstanding amount incurred by user",
      "type": "object",
      "properties": {
        "serialNo": {
          "type": "integer",
          "description": "Sequential entry number"
        },
        "date": {
          "type": "string",
          "description": "Date in YYYY-MM-DD format"
        },
        "amount": {
          "type": "number",
          "description": "Outstanding amount in BDT"
        },
        "note": {
          "type": "string",
          "description": "Optional note"
        },
        "createdAt": {
          "type": "integer",
          "description": "Creation timestamp in milliseconds"
        },
        "ownerUid": {
          "type": "string",
          "description": "User ID of the owner"
        }
      },
      "required": ["date", "amount"]
    },
    "PaymentRecord": {
      "title": "PaymentRecord",
      "description": "Outstanding repayment record",
      "type": "object",
      "properties": {
        "serialNo": {
          "type": "integer",
          "description": "Sequential entry number"
        },
        "date": {
          "type": "string",
          "description": "Date in YYYY-MM-DD format"
        },
        "amount": {
          "type": "number",
          "description": "Payment amount in BDT"
        },
        "note": {
          "type": "string",
          "description": "Optional note"
        },
        "createdAt": {
          "type": "integer",
          "description": "Creation timestamp in milliseconds"
        },
        "ownerUid": {
          "type": "string",
          "description": "User ID of the owner"
        }
      },
      "required": ["date", "amount"]
    },
    "BackupSnapshot": {
      "title": "BackupSnapshot",
      "description": "Versioned cloud backup snapshot",
      "type": "object",
      "properties": {
        "backupId": { "type": "string" },
        "backupTime": { "type": "string" },
        "timestamp": { "type": "integer" },
        "ownerUid": { "type": "string" },
        "schemaVersion": { "type": "integer" },
        "expensesCount": { "type": "integer" },
        "outstandingCount": { "type": "integer" },
        "paymentsCount": { "type": "integer" },
        "totalExpenses": { "type": "number" },
        "netBalance": { "type": "number" },
        "expensesJson": { "type": "string" },
        "outstandingJson": { "type": "string" },
        "paymentsJson": { "type": "string" }
      },
      "required": ["backupId", "timestamp", "ownerUid"]
    }
  },
  "firestore": {
    "/users/{userId}/market_expenses/{expenseId}": {
      "schema": "#/entities/MarketExpense",
      "description": "Market expenses scoped to the authenticated user"
    },
    "/users/{userId}/outstanding_entries/{entryId}": {
      "schema": "#/entities/OutstandingEntry",
      "description": "Outstanding entries scoped to the authenticated user"
    },
    "/users/{userId}/payment_records/{paymentId}": {
      "schema": "#/entities/PaymentRecord",
      "description": "Payments scoped to the authenticated user"
    },
    "/users/{userId}/backup_snapshots/{backupId}": {
      "schema": "#/entities/BackupSnapshot",
      "description": "Versioned backup snapshots for user recovery"
    },
    "/users/{userId}/sync_metadata/{metaId}": {
      "schema": "#/entities/BackupSnapshot",
      "description": "Latest sync status metadata"
    }
  }
}
