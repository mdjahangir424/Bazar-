rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidExpense(data) {
      return data.userId == request.auth.uid &&
             data.date is string &&
             data.amount is number &&
             data.amount > 0;
    }

    function isValidOutstanding(data) {
      return data.userId == request.auth.uid &&
             data.date is string &&
             data.amount is number &&
             data.amount > 0;
    }

    function isValidPayment(data) {
      return data.userId == request.auth.uid &&
             data.date is string &&
             data.amount is number &&
             data.amount > 0;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/backup_metadata/{metadataId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/market_expenses/{expenseId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidExpense(request.resource.data);
      allow update: if isOwner(userId) && isValidExpense(request.resource.data);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/outstanding_entries/{entryId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidOutstanding(request.resource.data);
      allow update: if isOwner(userId) && isValidOutstanding(request.resource.data);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/payment_records/{paymentId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidPayment(request.resource.data);
      allow update: if isOwner(userId) && isValidPayment(request.resource.data);
      allow delete: if isOwner(userId);
    }
  }
}
